// ==UserScript==
// @name         Hosp Filter
// @author       keenan
// @namespace    local.torn.hospital-networth-popup
// @version      1.0
// @description  Shows Hospital users matching an reason filter, hospital time, networth, war status
// @match        https://www.torn.com/hospitalview.php*
// @match        https://www.torn.com/*
// @run-at       document-idle
// @grant        GM_addStyle
// @grant        GM_getValue
// @grant        GM_setValue
// @grant        GM_deleteValue
// @grant        GM_xmlhttpRequest
// @connect      api.torn.com
// ==/UserScript==

(() => {
  'use strict';

  const API_KEY_STORAGE = 'tm_torn_hospital_networth_api_key';
  const API_REQUEST_DELAY_MS = 750;
  const PAGE_SIZE = 50;
  const PAGE_LOAD_TIMEOUT_MS = 15_000;
