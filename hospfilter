      color: #8fe88f !important;
    }

    #${IDS.popup} td.tm-error {
      color: #ffb3a7 !important;
    }

    #${IDS.popup} td.tm-muted {
      color: #9a9a9a !important;
    }

    #${IDS.popup} .tm-empty {
      padding: 14px;
      border: 1px solid #555;
      color: #ddd !important;
    }
